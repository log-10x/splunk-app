<form script="tenx_search_view.js" version="1.1" theme="light">
  <label>10x Search</label>
  <description>Search compact 10x events as if they were the original lines. Every search on this page is routed through the expansion endpoint.</description>
  <fieldset submitButton="true" autoRun="false">
    <input type="text" token="q" searchWhenChanged="false">
      <label>Search</label>
      <default>index=tenx_enc sourcetype=tenx_encoded</default>
    </input>
    <input type="time" token="t" searchWhenChanged="false">
      <label>Time range</label>
      <default><earliest>0</earliest><latest>now</latest></default>
    </input>
  </fieldset>
  <row>
    <panel>
      <html><div id="tenx-search-notice"></div></html>
    </panel>
  </row>
  <row>
    <panel>
      <event>
        <title>Events, expanded</title>
        <search>
          <query>$q$</query>
          <earliest>$t.earliest$</earliest>
          <latest>$t.latest$</latest>
        </search>
        <option name="count">20</option>
        <option name="type">list</option>
        <option name="raw.drilldown">none</option>
      </event>
    </panel>
  </row>
</form>
